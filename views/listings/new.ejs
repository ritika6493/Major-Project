<% layout("/layouts/boilerplate") %>

<div class="row my-4">
    <div class="col-12 col-md-10 col-lg-8 mx-auto">
        <div class="p-4 p-md-5 rounded-4 shadow-sm" style="background: var(--wl-surface); border: 1px solid var(--wl-border);">
            <div class="mb-4">
                <span class="wl-badge wl-badge--verified mb-2">Host Onboarding</span>
                <h1 class="wl-display wl-h2">List Your Space on Wanderlust</h1>
                <p class="wl-muted small">Share your home with global travelers. Fill in the essential details below to get published.</p>
            </div>

            <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="wl-field">
                    <label for="title" class="wl-label">Property Title</label>
                    <input 
                        id="title"
                        name="listing[title]" 
                        placeholder="e.g. Modern Cliffside Villa with Ocean View" 
                        type="text" 
                        class="wl-input"
                        required
                    />
                    <span class="wl-help">Catchy and descriptive (3-120 characters).</span>
                    <div class="invalid-feedback">Please enter a valid title.</div>
                </div>

                <div class="wl-field">
                    <label for="description" class="wl-label">Description</label>
                    <textarea 
                        id="description"
                        name="listing[description]" 
                        placeholder="Tell guests what makes your place special, the neighborhood, amenities..." 
                        class="wl-textarea"
                        rows="4"
                        required></textarea>
                    <div class="invalid-feedback">Please enter a short description.</div>
                </div>

                <div class="row">
                    <div class="col-12 col-md-6">
                        <div class="wl-field">
                            <label for="category" class="wl-label">Primary Category</label>
                            <select id="category" name="listing[category]" class="wl-select">
                                <option value="trending" selected>Trending</option>
                                <option value="rooms">Rooms</option>
                                <option value="iconic-cities">Iconic Cities</option>
                                <option value="mountains">Mountains</option>
                                <option value="castles">Castles</option>
                                <option value="pools">Amazing Pools</option>
                                <option value="camping">Camping</option>
                                <option value="farms">Farms</option>
                                <option value="arctic">Arctic</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="wl-field">
                            <label for="propertyType" class="wl-label">Property Type</label>
                            <select id="propertyType" name="listing[propertyType]" class="wl-select">
                                <option value="House" selected>House</option>
                                <option value="Apartment">Apartment</option>
                                <option value="Villa">Villa</option>
                                <option value="Cabin">Cabin</option>
                                <option value="Hotel">Hotel</option>
                                <option value="Cottage">Cottage</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="wl-field">
                    <label for="image" class="wl-label">Listing Photos</label>
                    <input id="image" name="listing[image]" type="file" class="wl-input" accept="image/*">
                    <span class="wl-help">Upload high-res JPG, PNG or WebP (max 15MB). A default image is provided if omitted.</span>
                </div>

                <div class="row">
                    <div class="col-12 col-md-4">
                        <div class="wl-field">
                            <label for="price" class="wl-label">Base Price / night (&#8377;)</label>
                            <input
                               id="price"
                               name="listing[price]"
                               type="number" 
                               placeholder="2500" 
                               min="0"
                               class="wl-input"
                               required
                            />
                            <div class="invalid-feedback">Price should be a valid positive number.</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-8">
                        <div class="wl-field">
                            <label for="country" class="wl-label">Country</label>
                            <input 
                                id="country" 
                                name="listing[country]" 
                                placeholder="e.g. India" 
                                type="text" 
                                class="wl-input"
                                required
                            />
                            <div class="invalid-feedback">Country name should be valid.</div>
                        </div>
                    </div>
                </div>
                
                <div class="wl-field">
                    <label for="location" class="wl-label">Location (City, Area, or Landmark)</label>
                    <input 
                        id="location" 
                        name="listing[location]" 
                        placeholder="e.g. Candolim, North Goa" 
                        type="text" 
                        class="wl-input"
                        required
                    />
                    <span class="wl-help">Used for automatic Mapbox geocoding and guest navigation.</span>
                    <div class="invalid-feedback">Location should be valid.</div>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <button class="wl-btn wl-btn--primary wl-btn--lg flex-grow-1">Publish Listing</button>
                    <a href="/listings" class="wl-btn wl-btn--secondary wl-btn--lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
