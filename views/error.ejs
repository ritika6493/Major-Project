<% layout("/layouts/boilerplate") %>

<div class="row my-5">
    <div class="col-12 col-md-8 col-lg-6 mx-auto text-center">
        <div class="p-5 rounded-4 shadow-sm" style="background: var(--wl-surface); border: 1px solid var(--wl-border);">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-3" style="background: var(--wl-coral-50); color: var(--wl-danger);">
                <i class="fa-solid fa-triangle-exclamation fs-1"></i>
            </div>
            <h1 class="wl-display wl-h2 mb-2">Something went wrong</h1>
            <p class="wl-muted mb-4"><%= message %></p>
            <div class="d-flex justify-content-center gap-2">
                <a href="/listings" class="wl-btn wl-btn--primary">Back to All Stays</a>
                <button onclick="history.back()" class="wl-btn wl-btn--secondary">Go Back</button>
            </div>
        </div>
    </div>
</div>
