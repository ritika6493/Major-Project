<% if (typeof success !== 'undefined' && success && success.length) { %>
<div class="wl-toast d-flex align-items-center justify-content-between gap-3 shadow-lg" role="alert">
    <div class="d-flex align-items-center gap-2">
        <i class="fa-solid fa-circle-check text-success fs-5"></i>
        <span><%= success %></span>
    </div>
    <button type="button" class="btn-close btn-close-white" aria-label="Close" onclick="this.parentElement.remove()"></button>
</div>
<% } %>
<% if (typeof error !== 'undefined' && error && error.length) { %>
<div class="wl-toast d-flex align-items-center justify-content-between gap-3 shadow-lg" style="background: var(--wl-danger);" role="alert">
    <div class="d-flex align-items-center gap-2">
        <i class="fa-solid fa-triangle-exclamation fs-5"></i>
        <span><%= error %></span>
    </div>
    <button type="button" class="btn-close btn-close-white" aria-label="Close" onclick="this.parentElement.remove()"></button>
</div>
<% } %>