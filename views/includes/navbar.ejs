<header class="wl-header">
  <div class="container-fluid px-3 px-md-4">
    <div class="wl-header__inner">
      <!-- Brand Logo -->
      <a class="d-flex align-items-center gap-2 text-decoration-none" href="/listings" aria-label="Wanderlust Home">
        <i class="fa-regular fa-compass fs-2 text-danger"></i>
        <span class="wl-display fs-4 d-none d-sm-inline text-dark">Wanderlust</span>
      </a>

      <!-- Center Search Pill -->
      <form action="/listings" method="GET" class="wl-search-pill my-0 d-none d-md-flex align-items-center">
        <label class="wl-search-pill__seg mb-0" style="cursor: text;">
          <span class="wl-search-pill__label">Where</span>
          <input 
            type="text" 
            name="q" 
            placeholder="Search destinations..." 
            class="border-0 bg-transparent p-0 w-100 wl-search-pill__value" 
            style="outline: none;"
            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          />
        </label>
        <button class="wl-search-pill__btn" type="submit" aria-label="Search">
          <i class="fa-solid fa-magnifying-glass" style="font-size: 0.85rem;"></i>
        </button>
      </form>

      <!-- Right Navigation Actions -->
      <div class="d-flex align-items-center gap-2">
        <button id="themeToggleBtn" class="wl-btn wl-btn--ghost wl-btn--sm rounded-circle p-0" style="width: 38px; height: 38px;" title="Toggle dark/light mode" aria-label="Toggle theme">
          <i class="fa-solid fa-moon"></i>
        </button>

        <a class="wl-btn wl-btn--ghost wl-btn--sm d-none d-lg-inline-flex" href="/listings/new">
          Airbnb your home
        </a>

        <% if (typeof currUser === 'undefined' || !currUser) { %>
          <a class="wl-btn wl-btn--secondary wl-btn--sm" href="/login">Log in</a>
          <a class="wl-btn wl-btn--primary wl-btn--sm" href="/signup">Sign Up</a>
        <% } else { %>
          <a class="wl-btn wl-btn--ghost wl-btn--sm d-none d-md-inline-flex" href="/host/dashboard" title="Host Dashboard">
            <i class="fa-solid fa-chart-line text-primary me-1"></i>Host Hub
          </a>
          <a class="wl-btn wl-btn--ghost wl-btn--sm d-none d-md-inline-flex" href="/wishlist" title="Wishlist">
            <i class="fa-regular fa-heart text-danger me-1"></i>Wishlist
          </a>
          <a class="wl-btn wl-btn--ghost wl-btn--sm d-none d-md-inline-flex" href="/trips" title="My Trips">
            <i class="fa-solid fa-suitcase-rolling text-secondary me-1"></i>My Trips
          </a>

          <!-- User Menu Dropdown -->
          <div class="dropdown">
            <button class="wl-btn wl-btn--secondary wl-btn--sm dropdown-toggle rounded-pill px-3" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fa-regular fa-circle-user me-1"></i>
              <span class="d-none d-sm-inline"><%= currUser.username.split('@')[0] %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-4 mt-2">
              <li><a class="dropdown-item py-2" href="/profile"><i class="fa-regular fa-id-card me-2"></i>Profile</a></li>
              <li><a class="dropdown-item py-2" href="/trips"><i class="fa-solid fa-suitcase me-2"></i>My Trips</a></li>
              <li><a class="dropdown-item py-2" href="/wishlist"><i class="fa-regular fa-heart me-2"></i>Wishlist</a></li>
              <li><a class="dropdown-item py-2" href="/host/dashboard"><i class="fa-solid fa-house-chimney me-2"></i>Host Dashboard</a></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form method="POST" action="/logout" class="px-2 py-1">
                  <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-pill">Log out</button>
                </form>
              </li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Mobile Search Row -->
    <div class="d-md-none pb-2 pt-1">
      <form action="/listings" method="GET" class="wl-search-pill w-100 my-0">
        <label class="wl-search-pill__seg mb-0 flex-grow-1" style="cursor: text;">
          <input 
            type="text" 
            name="q" 
            placeholder="Where to? Search destinations..." 
            class="border-0 bg-transparent p-0 w-100 wl-search-pill__value" 
            style="outline: none;"
            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
          />
        </label>
        <button class="wl-search-pill__btn" type="submit" aria-label="Search">
          <i class="fa-solid fa-magnifying-glass" style="font-size: 0.85rem;"></i>
        </button>
      </form>
    </div>
  </div>
</header>