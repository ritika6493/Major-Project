<% layout("/layouts/boilerplate") %>

<div class="row my-5 justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5">
        <div class="p-4 p-md-5 rounded-4 shadow-sm" style="background: var(--wl-surface); border: 1px solid var(--wl-border);">
            <div class="text-center mb-4">
                <i class="fa-regular fa-compass fs-1 text-danger mb-2"></i>
                <h1 class="wl-display wl-h2">Welcome to Wanderlust</h1>
                <p class="wl-muted small">Log in to book unique stays and manage your reservations</p>
            </div>

            <form action="/login" method="post" class="needs-validation" novalidate>
                <div class="wl-field">
                    <label for="username" class="wl-label">Email or Username</label>
                    <input 
                      name="username"  
                      id="username"
                      type="text" 
                      placeholder="your.email@example.com"
                      class="wl-input"
                      required/>
                    <div class="invalid-feedback">Please enter your username or email.</div>
                </div>

                <div class="wl-field">
                    <div class="d-flex justify-content-between align-items-center">
                        <label for="password" class="wl-label mb-0">Password</label>
                    </div>
                    <input 
                      name="password"  
                      id="password"
                      type="password" 
                      placeholder="••••••••"
                      class="wl-input"
                      required/>
                    <div class="invalid-feedback">Please enter your password.</div>
                </div>

                <button class="wl-btn wl-btn--primary wl-btn--block wl-btn--lg mt-2 mb-3">
                    Log In
                </button>

                <p class="text-center wl-muted small mb-0">
                    Don't have an account yet? 
                    <a href="/signup" class="fw-semibold text-danger text-decoration-none">Sign up</a>
                </p>
            </form>
        </div>
    </div>
</div>